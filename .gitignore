# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/recipes
!.yarn/releases
!.yarn/versions

# package-manager local store/cache (kept inside the project for sandboxed/reproducible builds)
/.pnpm-store/
/.pnpm-cache/
/.npm-cache/
/.home/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local/production env files (commit the *.example templates instead)
.env
.env.local
.env.development
.env.production
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local SQLite files; migrations under db/migrations ARE committed)
*.db
*.db-journal
*.db-wal
*.db-shm

# raw source material (large, local-only). Curated site assets live in public/assets/.
/resources/

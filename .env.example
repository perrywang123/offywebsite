# ---------------------------------------------------------------------------
# Server / database
# ---------------------------------------------------------------------------
# Local development uses SQLite (zero-dependency). For production, switch to
# PostgreSQL by setting DATABASE_PROVIDER=postgres and pointing DATABASE_URL at
# a PostgreSQL connection string (the data layer is isolated in
# src/server/db/client.ts, the schema stays the same via Drizzle).
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/offy.db

# ---------------------------------------------------------------------------
# Public site metadata (NEXT_PUBLIC_* values are exposed to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Offy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments (Stripe). Test-mode keys by default; switch to live keys in prod.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY

# ---------------------------------------------------------------------------
# Payments (PayPal). secret 仅服务端读取；沙箱密钥从 developer.paypal.com 获取。
# ---------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET

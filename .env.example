# ---------------------------------------------------------------------------
# Server / database
# ---------------------------------------------------------------------------
# SQLite is the only implemented provider. PostgreSQL requires schema, migration
# and async DAL work; changing this variable alone does not enable it.
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/offy.db
# Optional 64-character hex key; blank creates checkout-diagnostics.key beside the DB.
# Storefront and admin must share this key. Back it up with the database.
CHECKOUT_DIAGNOSTICS_KEY=

# ---------------------------------------------------------------------------
# Public site metadata (NEXT_PUBLIC_* values are exposed to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Offy
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Actual server metadata, sitemap and payment-return origin:
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Retained Stripe path, not offered in current UI. Optional keys must be blank
# when unused: non-empty placeholders are treated as configured, not disabled.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Retained PayPal path, not offered in current UI; leave credentials blank if unused.
# ---------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Payments (Shopify). Storefront API 托管结算：cartCreate → checkoutUrl。
# domain 形如 xxx.myshopify.com；token 为 Storefront API access token。
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=REPLACE_WITH_SHOPIFY_STORE_DOMAIN
SHOPIFY_STOREFRONT_TOKEN=REPLACE_WITH_SHOPIFY_STOREFRONT_TOKEN
# Optional admin-only runtime pair for an installed, same-organization Shopify app.
# Tokens are acquired/cached/renewed automatically; no scope changes are requested.
# Complete pair takes precedence over the manual token. Supply both or neither.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Manual Admin API token fallback when neither application credential is supplied.
# All blank: local management/diagnostics work, remote sync pauses. Never use Storefront tokens.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Default market only when visitor country cannot be determined; real requests use visitor country.
SHOPIFY_MARKET_COUNTRY=US

# KOL platform is opt-in. Generate three different >=32-character random secrets before enabling.
KOL_ENABLED=false
KOL_SETTLEMENTS_ENABLED=false
ADMIN_ORIGIN=https://admin.offy.example.com:8443
KOL_INGRESS_SECRET=
KOL_SIGNING_SECRET=
KOL_WORKER_SECRET=
# Optional notification signing secret. Server deploy manages internal KOL values.
SHOPIFY_WEBHOOK_SECRET=
# KOL_WORKER_URL=http://admin:3000/api/kol/worker
# Integration-only variables are deliberately absent from production templates.

# Production owner: wangperry666@gmail.com. Prepare locally via kol:admin prepare-production.
# Copy the private generated HASH to server runtime config, never a plaintext password.
KOL_ADMIN_BOOTSTRAP_HASH=

# Build-only resource limits; not passed to app/admin runtime.
DEPLOY_BUILD_CPUS=1
DEPLOY_BUILD_MEMORY_MB=1536

# Optional Nginx management by deploy/update.sh (host-side, not app environment).
# First obtain valid certificates, then select the site's ACTIVE config file explicitly.
DEPLOY_NGINX_CONFIG=
DEPLOY_SITE_TLS_CERTIFICATE=
DEPLOY_SITE_TLS_KEY=
DEPLOY_ADMIN_TLS_CERTIFICATE=
DEPLOY_ADMIN_TLS_KEY=
# Optional trusted CA bundle; HTTPS verification is never disabled.
DEPLOY_CA_FILE=

# Collabs primary accounting: offy retains historical local mode.
# Set collabs after official app setup; local settlement writes are then disabled.
KOL_ACCOUNTING_MODE=offy
# Numeric Shop ID from Shopify; public analytics metadata, not an access token.
SHOPIFY_ANALYTICS_SHOP_ID=
# Optional Headless storefront ID; Headless analytics does not use a Hydrogen storefront ID.
SHOPIFY_STOREFRONT_ID=

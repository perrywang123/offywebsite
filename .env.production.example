# Production environment. For a NEW server only, copy to `.env` and fill in.
# Keep an existing private runtime file; never overwrite it with this template.
#
#   cp .env.production.example .env
#   原Git目录：bash deploy/update-storefront.sh --kol（只主站）/ bash deploy/update-admin.sh（只后台）
#   首次可先主站后后台分次执行；整套仍为 bash deploy/update.sh --kol。
#   Runtime file: --env-file FILE > existing .env > .env.production fallback.
#
# DATABASE_URL must point at the persistent volume (/data) in Docker, or a
# persistent path (e.g. /var/lib/offy/offy.db) for the bare-Node deploy.

DATABASE_PROVIDER=sqlite
DATABASE_URL=/data/offy.db
# Optional 64-character hex encryption key. Blank: auto-create /data/checkout-diagnostics.key.
# Both containers share /data. Back up the key with the DB; do not rotate it while records remain.
CHECKOUT_DIAGNOSTICS_KEY=

NEXT_PUBLIC_SITE_NAME=Offy
NEXT_PUBLIC_SITE_URL=https://offy.example.com

# 服务端真正读的是这个(robots / sitemap / metadataBase,以及 Stripe/PayPal 的
# 结算回跳地址)。必须带 https://,env.ts 用 z.string().url() 校验,写错会启动即报错。
SITE_URL=https://offy.example.com

# ---------------------------------------------------------------------------
# Retained Stripe path (not in current UI). Leave optional keys blank if unused.
# Non-empty placeholders count as configured. Secret keys stay server-side only.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Payments (PayPal). secret 仅服务端读取；沙箱密钥从 developer.paypal.com 获取。
# ---------------------------------------------------------------------------
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Payments (Shopify). Storefront API 托管结算：cartCreate → checkoutUrl。
# ---------------------------------------------------------------------------
# 必须填写真实 Storefront 配置；读取失败只展示品牌化重试态，绝不回退本地商品/价格。
SHOPIFY_STORE_DOMAIN=REPLACE_WITH_SHOPIFY_STORE_DOMAIN
SHOPIFY_STOREFRONT_TOKEN=REPLACE_WITH_SHOPIFY_STOREFRONT_TOKEN
# 可选：已安装的同组织自有应用凭据，仅 admin 容器运行时接收，自动获取/缓存/续取令牌。
# 两项须同时配置；完整 pair 优先于下面的手动令牌，不会申请额外权限。
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# 未提供应用凭据时，兼容手动 Admin API access token；不能使用 Headless/Storefront token。
# 三项全空仍可登录、管理本地记录与结账诊断，远程同步暂停。更改后单独发布后台生效。
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_MARKET_COUNTRY=US

# 「区域限定」按访客国家展示时要比对的国家(ISO-3166 alpha-2,逗号分隔)。
# 留空用内置30国，完整列表见 docs/shopify-regional-config.md。
# 注意：当前Compose未转发这两个可选变量；仅写宿主.env不会进入容器。
# SHOPIFY_REGIONS=US,CA,GB,SG,HK,MY
#
# 允许展示「区域限定」的访客国家(逗号分隔)。留空用默认 US,GB,SG,HK。
# 不在名单里的访客一律不展示这块内容 —— 商品发布到的是 Market,一个 Market
# 常含多国,不设白名单会让非目标国访客看到凭空造出的"仅限某国"徽章。
# SHOPIFY_TARGET_MARKETS=US,GB,SG,HK

# KOL platform is opt-in. Deployment automatically manages internal authentication.
# --kol/update-admin.sh enable KOL for that command even if this switch is false.
# Use explicit mode on subsequent updates too, or set true here for ordinary updates.
# Neither explicit mode modifies this private file nor enables settlements.
KOL_ENABLED=false
KOL_SETTLEMENTS_ENABLED=false
ADMIN_ORIGIN=https://admin.offy.example.com:8443
# Optional legacy overrides. Normally leave blank; deploy/update.sh persists
# internal authentication privately in .offy-runtime-secrets.json on the SERVER.
KOL_INGRESS_SECRET=
KOL_SIGNING_SECRET=
KOL_WORKER_SECRET=
# Optional real Shopify notification signing secret. Blank: scheduled Admin API
# reconciliation remains available; unsigned/unconfigured webhooks are rejected.
SHOPIFY_WEBHOOK_SECRET=
# KOL_WORKER_URL=http://admin:3000/api/kol/worker
# Integration-only variables are deliberately absent from production templates.

# Single production owner: server-only config/admin-account.json provides the
# authorized salted hash for first initialization. Existing passwords are preserved.
# Optional private bootstrap HASH override; never set a plaintext password here.
KOL_ADMIN_BOOTSTRAP_HASH=

# Aggregate CPU budget for ALL image builds, not running services. Default: one CPU.
# Docker Buildx >=0.14.0 and Compose build --builder support are required.
DEPLOY_BUILD_CPUS=1
# Hard builder memory ceiling; 512 MiB additional available host RAM is required.
# Builder memory+swap equals this ceiling, so the builder cannot swap.
DEPLOY_BUILD_MEMORY_MB=1536

# Optional Nginx management by deploy/update.sh (host-side, not app environment).
# First obtain valid certificates, then select the site's ACTIVE config file explicitly.
DEPLOY_NGINX_CONFIG=
DEPLOY_SITE_TLS_CERTIFICATE=
DEPLOY_SITE_TLS_KEY=
DEPLOY_ADMIN_TLS_CERTIFICATE=
DEPLOY_ADMIN_TLS_KEY=
# Optional trusted CA bundle; HTTPS verification is never disabled.
DEPLOY_CA_FILE=

# Collabs primary accounting: offy retains historical local mode.
# Set collabs after official app setup; local settlement writes are then disabled.
KOL_ACCOUNTING_MODE=offy
# Numeric Shop ID from Shopify; public analytics metadata, not an access token.
SHOPIFY_ANALYTICS_SHOP_ID=
# Optional Headless storefront ID; Headless analytics does not use a Hydrogen storefront ID.
SHOPIFY_STOREFRONT_ID=

# Meta storefront funnel: optional, runtime only; Shopify keeps Purchase ownership.
META_TRACKING_ENABLED=false
META_PIXEL_ID=
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_CAPI_TEST_EVENT_CODE=
# Exact product code -> Meta catalog retailer ID JSON, single-quote in .env.
META_CATALOG_IDS=
# Existing KOL deployments may leave empty and reuse private KOL_WORKER_SECRET.
META_WORKER_SECRET=

# Shipping destination: only set a country header if the trusted ingress overwrites it.
# Blank on the standard Nginx install: use overwritten X-Real-IP, then browser hints, then US.
GEO_TRUSTED_COUNTRY_HEADER=
GEOIP_COUNTRY_DATABASE=/data/GeoLite2-Country.mmdb

# Production environment. Copy to `.env.production`, fill in, then deploy.
#
#   cp .env.production.example .env.production
#   DEPLOY_SERVER=root@你的IP DEPLOY_DIR=/opt/offy ./scripts/deploy.sh
#
# DATABASE_URL must point at the persistent volume (/data) in Docker, or a
# persistent path (e.g. /var/lib/offy/offy.db) for the bare-Node deploy.

DATABASE_PROVIDER=sqlite
DATABASE_URL=/data/offy.db

NEXT_PUBLIC_SITE_NAME=Offy
NEXT_PUBLIC_SITE_URL=https://offy.example.com
